# Berlin Housing AI — environment configuration
# Copy to .env.local. No variables are required to run the app.

# Prediction integration: disabled | direct | proxy | embedded   (docs/contracts/PREDICTION_API.md §7)
# embedded = the demo model (trained on synthetic data, D-061) runs inside this server. No other service needed.
NEXT_PUBLIC_PREDICTION_MODE=disabled

# direct mode only: public, CORS-enabled FastAPI base URL (no secrets here, this ships to browsers)
NEXT_PUBLIC_API_BASE_URL=

# proxy mode only: server-side upstream. These are never exposed to the client.
# The local demo model (services/rent-api, trained on synthetic data, D-058): http://127.0.0.1:8000
PREDICTION_API_BASE_URL=
PREDICTION_API_KEY=
PREDICTION_TIMEOUT_MS=10000

# Optional street basemap on /explore (OpenFreeMap). Keep false until its terms are reviewed (DECISIONS D-004).
NEXT_PUBLIC_ENABLE_BASEMAP=false
